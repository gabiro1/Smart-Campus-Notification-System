{
  "expo": {
    "name": "Event Alert Reminder",
    "slug": "event-alert-reminder",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "android": {
      "usesCleartextTraffic": true,
      "package": "com.ear.mobile"
    },
    "plugins": [
        "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
