# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in the values
# NEVER commit .env files to version control!

# ==========================================
# API URL (for frontend build)
# ==========================================
API_URL=https://your-domain.com/api

# ==========================================
# Server Configuration
# ==========================================
NODE_ENV=production
PORT=8000
FRONTEND_URL=https://your-domain.com

# ==========================================
# MongoDB
# ==========================================
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/uni-notify?retryWrites=true&w=majority
MONGO_DATABASE=uni-notify

# ==========================================
# Authentication (GENERATE SECURE VALUES!)
# ==========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-min-32-chars

# ==========================================
# Email (Nodemailer)
# ==========================================
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password

# ==========================================
# Twilio SMS
# ==========================================
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_NUMBER=+1234567890

# ==========================================
# Firebase (Push Notifications)
# Download service account JSON from Firebase Console
# Place as: backend/firebase-service-account-key.json
# ==========================================
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account-key.json

# ==========================================
# AI Providers
# ==========================================
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# ==========================================
# Rate Limiting (Optional)
# ==========================================
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
