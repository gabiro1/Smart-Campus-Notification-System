# ==========================================
# Smart Campus Notification System - Backend
# ==========================================

# Server
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/uni-notify?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this

# Email (Nodemailer)
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-app-specific-password

# Twilio (SMS)
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_NUMBER=+15017122661

# Firebase (Push Notifications)
# Download service account key from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account-key.json

# Google GenAI (Copilot RAG)
GEMINI_API_KEY=AIzaSy...

# Groq (Kinyarwanda Translation)
GROQ_API_KEY=gsk_...

# ==========================================
# Optional: Rate Limiting & Monitoring
# ==========================================
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
